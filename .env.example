# Copy this file to `.env.local` and fill in the values.

# Public — safe to expose in the browser (needed by the embedded Studio).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20

# Server-only — shared secret for the /api/revalidate webhook (required for
# on-demand revalidation). Generate one with `openssl rand -hex 24`.
REVALIDATE_SECRET=

# Server-only — read token from api.sanity.io. Only needed for draft/preview
# features (not part of the core blog setup). Optional.
SANITY_API_TOKEN=

# Server-only — Google Places API (v1) for the homepage's live Google Reviews
# (lib/reviews/google-reviews.ts). Never prefix with NEXT_PUBLIC_.
#   GOOGLE_PLACES_API_KEY: from Google Cloud Console → enable the Places API →
#     Credentials → Create API key.
#   GOOGLE_PLACE_ID: OPTIONAL — the business's place_id if you already have a
#     stable one. Set it to pin the exact listing; leave blank to search by name.
#   GOOGLE_PLACES_QUERY: the business's display name (e.g. "BEA VITA Tours").
#     Required when GOOGLE_PLACE_ID is blank. places:searchText with
#     includePureServiceAreaBusinesses:true finds Service Area Businesses that
#     the old Place Details API excluded — this is the path that finds ours.
# With none of these set, the section renders static badges + manual reviews only.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACES_QUERY=

# --- Regiondo booking API -----------------------------------------------------
# Server-only. NEVER prefix any of these with NEXT_PUBLIC_ — the private key is
# an HMAC signing secret and must not reach the browser bundle. lib/regiondo/*
# is guarded with `import "server-only"` so an accidental client import fails
# the build rather than shipping the key.
#
# Keys come from the Regiondo Pro dashboard (Settings -> API). No dashboard
# login is needed at runtime; the site authenticates only with these two.
REGIONDO_PUBLIC_KEY=
REGIONDO_PRIVATE_KEY=

# Optional sandbox pair. sandbox-api.regiondo.com rejects live keys with 403, so
# leave these blank unless a separate sandbox account has been provisioned.
REGIONDO_SANDBOX_PUBLIC_KEY=
REGIONDO_SANDBOX_PRIVATE_KEY=

# Which API host to talk to: "live" (default) or "sandbox".
REGIONDO_API_ENV=live

# Account facts. Derived from the API (GET /account/currency, /account/locale,
# and product_supplier_id on any product) — they are not secrets.
REGIONDO_VENDOR_ID=
REGIONDO_DEFAULT_LOCALE=en-US
REGIONDO_CURRENCY=EUR

# Comma-separated product IDs behind the legacy widget embeds. Used to seed the
# slug registry check and the landing-page product sets.
REGIONDO_WIDGET_OFFER_IDS=

# How the account takes payment. "hosted" means checkout completes on Regiondo's
# ticketshop and no card data ever reaches this origin. Any other value is
# unsupported by this integration on purpose — see docs/regiondo-integration.md.
REGIONDO_PAYMENT_MODE=hosted

# Feature flag for the native booking flow. Off by default; while it is off the
# site renders the legacy Regiondo widget/iframe embeds unchanged.
REGIONDO_NATIVE_BOOKING=false
