# Copy this file to `.env.local` and fill in the values.

# Public — safe to expose in the browser (needed by the embedded Studio).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-20

# Server-only — shared secret for the /api/revalidate webhook (required for
# on-demand revalidation). Generate one with `openssl rand -hex 24`.
REVALIDATE_SECRET=

# Server-only — read token from api.sanity.io. Only needed for draft/preview
# features (not part of the core blog setup). Optional.
SANITY_API_TOKEN=
